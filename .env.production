VITE_API_BASE=https://api.sushijia.com

# JWT signing secret. Use a strong private value in production.
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET

# DashScope API Key. Do not commit a real key.
DASHSCOPE_API_KEY=CHANGE_THIS_TO_YOUR_DASHSCOPE_API_KEY

# Allowed frontend origins.
CORS_ORIGINS=https://sushijia.com,https://www.sushijia.com

# apimart.ai image generation API Key.
APIMART_API_KEY=CHANGE_THIS_TO_YOUR_APIMART_API_KEY
